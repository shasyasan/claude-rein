    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/rein-hook-launcher.sh\" user-prompt-submit",
            "timeout": 10
          }
